        android:fillColor="#00000000"
        android:pathData="M 54,23 L 54,30 M 54,78 L 54,85 M 23,54 L 30,54 M 78,54 L 85,54 M 32,32 L 37,37 M 71,71 L 76,76 M 76,32 L 71,37 M 32,76 L 37,71" />

