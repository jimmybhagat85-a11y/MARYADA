        android:fillColor="#00000000"
        android:pathData="M 33,54 L 75,54" />

    <!-- Arrow Head (Golden Spearhead) -->
    <path
        android:fillColor="#FFFFF0"
        android:strokeColor="#FFD700"
        android:strokeWidth="1.0"
        android:pathData="M 72,48 L 81,54 L 72,60 L 74,54 Z" />

    <!-- Arrow Fletching (Feathers at rear) -->
    <path
        android:strokeColor="#FFD700"
