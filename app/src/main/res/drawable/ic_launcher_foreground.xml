        android:fillColor="#00000000"
        android:pathData="M 54,28 A 26,26 0 1,1 53.9,28 Z" />

    <!-- Sacred Kodanda Bow (Left Arched Curve) -->
    <path
        android:strokeWidth="3.2"
        android:strokeLineCap="round"
        android:fillColor="#00000000"
        android:pathData="M 40,28 C 30,38 30,70 40,80">
        <aapt:attr name="android:strokeColor">
