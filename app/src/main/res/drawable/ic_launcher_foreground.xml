                <item android:offset="0.5" android:color="#FFD700" />
                <item android:offset="1.0" android:color="#D4AF37" />
            </gradient>
        </aapt:attr>
    </path>

    <!-- Bow String -->
    <path
        android:strokeColor="#E6FFFAED"
